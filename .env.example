# EmailJS — contact form delivery (https://dashboard.emailjs.com)
# Copy this file to `.env` and fill in your values. Never commit `.env`.
#
#   Service ID  → Email Services → your Gmail service → "Service ID"
#   Template ID → Email Templates → your template → Settings → "Template ID"
#   Public Key  → Account → General → "Public Key"
#
# These are public identifiers (they are bundled into the site), not secrets.
# Do NOT put your EmailJS *Private* Key or Gmail password anywhere in this project.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
